{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "actions": {
            "Initialize_UncrawledFolders": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "UncrawledFolders",
                            "type": "array",
                            "value": [
                                "@triggerBody()?['folder']"
                            ]
                        }
                    ]
                },
                "runAfter": {}
            },
            "Initialize_LoopIndex": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "LoopIndex",
                            "type": "integer",
                            "value": 0
                        }
                    ]
                },
                "runAfter": {
                    "Initialize_UncrawledFolders": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Until": {
                "type": "Until",
                "expression": "@or(equals(sub(length(variables('UncrawledFolders')), 1),variables('LoopIndex')),not(empty(variables('ErrorFiles'))))",
                "limit": {
                    "count": 5000,
                    "timeout": "PT24H"
                },
                "actions": {
                    "Increment_LoopIndex": {
                        "type": "SetVariable",
                        "inputs": {
                            "name": "LoopIndex",
                            "value": "@int(iterationIndexes('Until'))"
                        }
                    },
                    "Get_files_(properties_only)": {
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "referenceName": "sharepointonline"
                                }
                            },
                            "method": "get",
                            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_site_address')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('sharepoint_document_library')))}/getfileitems",
                            "queries": {
                                "$top": 5000,
                                "folderPath": "@variables('UncrawledFolders')[variables('LoopIndex')]",
                                "viewScopeOption": "Default"
                            }
                        },
                        "runAfter": {
                            "Increment_LoopIndex": [
                                "SUCCEEDED"
                            ]
                        }
                    },
                    "For_each": {
                        "type": "Foreach",
                        "foreach": "@body('Get_files_(properties_only)')?['value']",
                        "actions": {
                            "If_Folder": {
                                "type": "If",
                                "expression": {
                                    "and": [
                                        {
                                            "equals": [
                                                "@item()?['{IsFolder}']",
                                                true
                                            ]
                                        }
                                    ]
                                },
                                "actions": {
                                    "Append_folder_to_UncrawledFolders": {
                                        "type": "AppendToArrayVariable",
                                        "inputs": {
                                            "name": "UncrawledFolders",
                                            "value": "@item()?['{FullPath}']"
                                        }
                                    }
                                },
                                "else": {
                                    "actions": {
                                        "If_Blob_Exists_and_Indexed": {
                                            "type": "If",
                                            "expression": {
                                                "and": [
                                                    {
                                                        "equals": [
                                                            "@body('Parse_JSON')?['mainBlob']",
                                                            true
                                                        ]
                                                    },
                                                    {
                                                        "equals": [
                                                            "@body('Parse_JSON')?['itemStatus']",
                                                            "INDEXED"
                                                        ]
                                                    },
                                                    {
                                                        "equals": [
                                                            "@body('Parse_JSON')?['contentBlob']",
                                                            true
                                                        ]
                                                    }
                                                ]
                                            },
                                            "actions": {
                                                "Update_or_Skip": {
                                                    "type": "Workflow",
                                                    "inputs": {
                                                        "host": {
                                                            "workflow": {
                                                                "id": "sharepoint-ingest-blob-exists-child"
                                                            }
                                                        },
                                                        "body": {
                                                            "id": "@item()?['ID']",
                                                            "fullpath": "@item()?['{FullPath}']",
                                                            "category": "@triggerBody()?['category']"
                                                        }
                                                    }
                                                }
                                            },
                                            "else": {
                                                "actions": {
                                                    "If_not_exists_and_not_indexed": {
                                                        "type": "If",
                                                        "expression": {
                                                            "and": [
                                                                {
                                                                    "equals": [
                                                                        "@and(not(body('Parse_JSON')?['mainBlob']),not(body('Parse_JSON')?['contentBlob']),equals(0,body('Parse_JSON')?['cosmosCount']))",
                                                                        true
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        "actions": {
                                                            "Index_and_Sync": {
                                                                "type": "Workflow",
                                                                "inputs": {
                                                                    "host": {
                                                                        "workflow": {
                                                                            "id": "index-and-sync-child"
                                                                        }
                                                                    },
                                                                    "body": {
                                                                        "identifier": "@item()?['{Identifier}']",
                                                                        "fullpath": "@item()?['{FullPath}']",
                                                                        "category": "@triggerBody()?['category']"
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "else": {
                                                            "actions": {
                                                                "Append_to_Error_Files": {
                                                                    "type": "AppendToArrayVariable",
                                                                    "inputs": {
                                                                        "name": "ErrorFiles",
                                                                        "value": "@item()?['{FullPath}']"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            },
                                            "runAfter": {
                                                "Parse_JSON": [
                                                    "SUCCEEDED"
                                                ]
                                            }
                                        },
                                        "Check_File_Conditions": {
                                            "type": "Workflow",
                                            "inputs": {
                                                "host": {
                                                    "workflow": {
                                                        "id": "check-file-conditions"
                                                    }
                                                },
                                                "body": {
                                                    "blobName": "@{concat('/',replace(parameters('sharepoint_site_address'),'https://',''))}/@{item()?['{FullPath}']}"
                                                }
                                            }
                                        },
                                        "Parse_JSON": {
                                            "type": "ParseJson",
                                            "inputs": {
                                                "content": "@body('Check_File_Conditions')",
                                                "schema": {
                                                    "type": "object",
                                                    "properties": {
                                                        "mainBlob": {
                                                            "type": "boolean"
                                                        },
                                                        "contentBlob": {
                                                            "type": "boolean"
                                                        },
                                                        "cosmosCount": {
                                                            "type": "integer"
                                                        },
                                                        "itemStatus": {
                                                            "type": "string"
                                                        },
                                                        "conflictingFileName": {
                                                            "type": "boolean"
                                                        }
                                                    }
                                                }
                                            },
                                            "runAfter": {
                                                "Check_File_Conditions": [
                                                    "SUCCEEDED"
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "runAfter": {
                            "Get_files_(properties_only)": [
                                "SUCCEEDED"
                            ]
                        },
                        "runtimeConfiguration": {
                            "concurrency": {
                                "repetitions": 1
                            }
                        }
                    }
                },
                "runAfter": {
                    "Initialize_ErrorFiles": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Response": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": 200
                },
                "runAfter": {
                    "Until": [
                        "SUCCEEDED"
                    ]
                }
            },
            "Initialize_ErrorFiles": {
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "ErrorFiles",
                            "type": "array",
                            "value": []
                        }
                    ]
                },
                "runAfter": {
                    "Initialize_LoopIndex": [
                        "SUCCEEDED"
                    ]
                }
            }
        },
        "contentVersion": "1.0.0.0",
        "outputs": {},
        "triggers": {
            "When_a_HTTP_request_is_received": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "folder": {
                                "type": "string"
                            },
                            "category": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "kind": "Stateful"
}